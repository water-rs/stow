#!/usr/bin/env bash
# Generated by ci/glibc-sysroot/wrappers.sh — bash for arrays (argv is
# rebuilt token-safe). Retarget literal /usr/include mentions
# at the sysroot so no TU parses host glibc headers.
args=()
while (( $# > 0 )); do
  case "$1" in
    -I|-isystem)
      if [[ "${2:-}" == "/usr/include" || "${2:-}" == "/usr/include/" ]]; then
        args+=("$1@SYSROOT@/@ARCH@/usr/include")
        shift 2
        continue
      fi
      ;;
    -I/usr/include|-I/usr/include/)
      args+=("-I@SYSROOT@/@ARCH@/usr/include")
      shift
      continue
      ;;
    -isystem/usr/include|-isystem/usr/include/)
      args+=("-isystem@SYSROOT@/@ARCH@/usr/include")
      shift
      continue
      ;;
  esac
  args+=("$1")
  shift
done
want_cxx=@CXX@
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    *.cc|*.cpp|*.cxx|*.c++|*.C|*.CPP|*.mm|*.ixx|*.cppm|*.ccm|*.cxxm|-xc++*|-x=c++*)
      want_cxx=1 ;;
    -x)
      [[ "${args[i+1]:-}" == c++* ]] && want_cxx=1 ;;
  esac
done
cxx_args=()
if (( want_cxx )); then
  cxx_args=(-nostdinc++ -I@SYSROOT@/@ARCH@/usr/include/c++/8 -I@SYSROOT@/@ARCH@/usr/include/@TRIPLE@/c++/8)
fi
exec @REAL@   -B@SYSROOT@/@ARCH@/usr/lib/@TRIPLE@   -B@SYSROOT@/@ARCH@/lib/@TRIPLE@   --sysroot=@SYSROOT@/@ARCH@   "${cxx_args[@]}"   "${args[@]}"   -idirafter /usr/include
